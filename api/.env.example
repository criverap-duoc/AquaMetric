# Copy to api/.env (never committed) and adjust per environment.
# The API refuses to start without INGEST_API_KEY.
ENV=local
DATABASE_URL=postgresql+asyncpg://aquametric:aquametric@localhost:5433/aquametric
INGEST_API_KEY=change-me-local-dev-key
# Comma-separated allowlist; no wildcards.
CORS_ORIGINS=http://localhost:5174
CATALOG_DIR=../catalog
AWS_REGION=us-east-1
S3_BUCKET=
# false while the demo feeds the API directly (ADR-004); the pipeline screen says so.
AWS_PIPELINE_DEPLOYED=false
BASELINE_MIN_POINTS=20
CENSORED_MAX_FRACTION=0.2
LOG_LEVEL=INFO
